# ------------------------------------------------------------------
# Construtora Caciamani — variáveis de ambiente
#
# Copie este arquivo para `.env.local` e preencha. O `.env.local` está
# no .gitignore e NUNCA deve ser commitado.
# Nenhuma chave, token ou credencial pode aparecer no código-fonte.
# ------------------------------------------------------------------

# URL canônica do site. Usada em metadados, Open Graph, sitemap e
# JSON-LD. Em desenvolvimento pode ficar como http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://construtoracaciamani.com.br"

# ---- Supabase ----------------------------------------------------
# Painel do projeto > Project Settings > API.
#
# Antes de preencher, rode no SQL Editor, nesta ordem:
#   supabase/migracoes/0001_leads.sql
#   supabase/migracoes/0002_conteudo.sql
#
# Depois crie o usuário do Carlos em Authentication > Users > Add user.
# NÃO existe cadastro aberto no site — o acesso é criado à mão aqui.

# URL do projeto. Pública por natureza.
NEXT_PUBLIC_SUPABASE_URL=""

# Chave anônima. Pública, protegida por Row Level Security. É a única
# que o site usa: gravar lead, ler conteúdo publicado e autenticar o
# painel. A chave de serviço não é usada em lugar nenhum, de propósito —
# ela ignora RLS e não tem por que existir numa aplicação web.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---- Modo demonstração -------------------------------------------
# "true" liga o conteúdo demonstrativo de `src/content/demo.ts`, para
# apresentar o site ao Carlos sem seção vazia: números, portfólio,
# depoimentos, área de atendimento e coeficientes do orçamento.
#
# O dado real sempre vence — o demo só preenche o que banco e semente
# deixaram em branco. Nada de CNPJ, CREA, endereço ou fala do Carlos é
# preenchido por aqui, nem com a flag ligada.
#
# APAGAR OU DEIXAR VAZIA ANTES DE O SITE IR AO AR DE VERDADE.
NEXT_PUBLIC_MODO_DEMO="true"

# ---- Aviso de lead novo (opcional) -------------------------------
# Sem estas três, o lead é gravado normalmente e nada quebra — só não
# chega aviso. Conta gratuita no resend.com cobre este volume.

RESEND_API_KEY=""

# Para onde vai o aviso. Pode ser o e-mail do Carlos.
EMAIL_AVISO_LEAD=""

# De onde sai o aviso. Precisa ser de um domínio verificado no Resend.
# Ex.: "Site Caciamani <site@construtoracaciamani.com.br>"
EMAIL_REMETENTE=""
